{
  "name": "neurablog",
  "version": "1.0.0",
  "description": "Simple SCSS builder for NeuraBlog",
  "scripts": {
    "build": "npm-run-all --parallel build:*",
    "dev": "npm-run-all --parallel watch:*",

    "build:public": "sass resources/scss/public/public.scss public/assets/css/public.css --style=compressed",
    "build:dashboard": "sass resources/scss/dashboard/dashboard.scss public/assets/css/dashboard.css --style=compressed",

    "build:js:public": "esbuild resources/js/public/public.js --bundle --outfile=public/assets/js/public.js --minify",
    "build:js:dashboard": "esbuild resources/js/dashboard/dashboard.js --bundle --outfile=public/assets/js/dashboard.js --minify",

    "watch:public": "sass --watch resources/scss/public/public.scss:public/assets/css/public.css",
    "watch:dashboard": "sass --watch resources/scss/dashboard/dashboard.scss:public/assets/css/dashboard.css",

    "watch:js:public": "esbuild resources/js/public/public.js --bundle --outfile=public/assets/js/public.js --watch",
    "watch:js:dashboard": "esbuild resources/js/dashboard/dashboard.js --bundle --outfile=public/assets/js/dashboard.js --watch",

    "build:js:auth": "esbuild resources/js/auth/auth.js --bundle --outfile=public/assets/js/auth.js --minify",
    "watch:js:auth": "esbuild resources/js/auth/auth.js --bundle --outfile=public/assets/js/auth.js --watch"
  },

  "devDependencies": {
    "esbuild": "^0.25.4",
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.0"
  }
}
